{
  "manifest_version": 3,
  "name": "Conversation Workbench for AI Chat",
  "version": "2.9.0",
  "description": "A productivity toolkit for organizing, searching, collapsing, navigating, and exporting long conversations. Supports ChatGPT, Doubao, DeepSeek, Tongyi Qianwen, Kimi, Wenxin Yiyan, and more.",
  "icons": {
    "16": "image/icon_16.png",
    "32": "image/icon_32.png",
    "48": "image/icon_48.png",
    "128": "image/icon_128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*",
        "https://chat.deepseek.com/*",
        "https://deepseek.com/*",
        "https://tongyi.aliyun.com/*",
        "https://qianwen.aliyun.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.moonshot.cn/*",
        "https://yiyan.baidu.com/*",
        "https://chatglm.cn/*",
        "https://www.chatglm.cn/*",
        "https://xinghuo.xfyun.cn/*",
        "https://www.xinghuo.xfyun.cn/*",
        "https://claude.ai/*",
        "https://poe.com/*",
        "https://www.poe.com/*",
        "https://chat.coze.cn/*",
        "https://www.coze.cn/*",
        "https://huggingface.co/chat/*",
        "https://www.huggingface.co/chat/*"
      ],
      "js": [
        "core/app-state.js",
        "core/locales.js",
        "utils/storage-bridge.js",
        "utils/dom-helpers.js",
        "utils/chat-selectors.js",
        "core/conversation-store.js",
        "interface/theme-sync.js",
        "modules/sidebar-folders.js",
        "modules/conversation-search.js",
        "modules/conversation-timeline.js",
        "modules/prompt-vault.js",
        "modules/conversation-fold.js",
        "modules/conversation-export.js",
        "interface/floating-toolbar.js",
        "bootstrap.js"
      ],
      "css": [
        "toolkit.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "image/icon_48.png",
        "image/icon_32.png"
      ],
      "matches": [
        "https://chat.openai.com",
        "https://chatgpt.com",
        "https://www.doubao.com",
        "https://doubao.com",
        "https://chat.deepseek.com",
        "https://deepseek.com",
        "https://tongyi.aliyun.com",
        "https://qianwen.aliyun.com",
        "https://kimi.moonshot.cn",
        "https://www.moonshot.cn",
        "https://yiyan.baidu.com",
        "https://chatglm.cn",
        "https://www.chatglm.cn",
        "https://xinghuo.xfyun.cn",
        "https://www.xinghuo.xfyun.cn",
        "https://claude.ai",
        "https://poe.com",
        "https://www.poe.com",
        "https://chat.coze.cn",
        "https://www.coze.cn",
        "https://huggingface.co",
        "https://www.huggingface.co"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://www.doubao.com/*",
    "https://doubao.com/*",
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://tongyi.aliyun.com/*",
    "https://qianwen.aliyun.com/*",
    "https://kimi.moonshot.cn/*",
    "https://www.moonshot.cn/*",
    "https://yiyan.baidu.com/*",
    "https://chatglm.cn/*",
    "https://www.chatglm.cn/*",
    "https://xinghuo.xfyun.cn/*",
    "https://www.xinghuo.xfyun.cn/*",
    "https://claude.ai/*",
    "https://poe.com/*",
    "https://www.poe.com/*",
    "https://chat.coze.cn/*",
    "https://www.coze.cn/*",
    "https://huggingface.co/chat/*",
    "https://www.huggingface.co/chat/*"
  ]
}